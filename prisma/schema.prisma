generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  MEMBER
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  NEEDS_REVIEW
}

enum ReportingPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReportAuditAction {
  CREATED
  UPDATED
  IMPORTED
  IMPORT_REMOVED
  SUBMITTED
  RESUBMITTED
  APPROVED
  NEEDS_REVIEW
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  memberships  Membership[]
  reports      SalesReport[] @relation("ReportOwner")
  targets      SalesTarget[] @relation("TargetOwner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  memberships Membership[]
  periods     ReportingPeriod[]
  reports     SalesReport[]
  targets     SalesTarget[]
  auditLogs   ReportAuditLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model ReportingPeriod {
  id          String              @id @default(cuid())
  workspaceId String
  type        ReportingPeriodType
  label       String
  startDate   DateTime
  endDate     DateTime
  reports     SalesReport[]
  targets     SalesTarget[]
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([workspaceId, type, startDate])
}

model SalesReport {
  id          String           @id @default(cuid())
  workspaceId String
  memberId    String
  periodId    String
  reportDate  DateTime
  status      SubmissionStatus @default(DRAFT)
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewerId  String?
  notes       String?          @db.Text
  rows        SalesReportRow[]
  auditLogs   ReportAuditLog[]
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member      User             @relation("ReportOwner", fields: [memberId], references: [id], onDelete: Cascade)
  period      ReportingPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, memberId, reportDate])
  @@index([workspaceId, status])
  @@index([periodId])
}

model ReportAuditLog {
  id          String            @id @default(cuid())
  workspaceId String
  reportId    String
  actorId     String
  action      ReportAuditAction
  message     String?           @db.Text
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  report      SalesReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([reportId, createdAt])
  @@index([actorId])
}

model SalesReportRow {
  id             String      @id @default(cuid())
  reportId       String
  customer       String
  product        String
  salesAmount    Decimal     @db.Decimal(12, 2)
  unitsSold      Int
  notes          String?     @db.Text
  rowOrder       Int         @default(0)
  importBatchId  String?
  importFilename String?
  report         SalesReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([reportId, rowOrder])
  @@index([reportId, importBatchId])
}

model SalesTarget {
  id          String          @id @default(cuid())
  workspaceId String
  memberId    String
  periodId    String
  amount      Decimal         @db.Decimal(12, 2)
  units       Int?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member      User            @relation("TargetOwner", fields: [memberId], references: [id], onDelete: Cascade)
  period      ReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([workspaceId, memberId, periodId])
  @@index([workspaceId, periodId])
}
